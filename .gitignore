# --- Heavy Video Files (> 25MB Cloudflare Pages Limit) ---
# Embed videos via YouTube iframe embeds for fast progressive streaming
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm

# Whitelist small on-ground web video clip (< 2MB)
!videos/flood_relief_gail.mp4

# Explicitly ignore large historical raw files
images/gallery/aiims_gallery/AIIMS_inauguration.mp4
images/gallery/bbci_gallery/BBCI_foodvehicle.mp4
images/gallery/bbci_gallery/bbci_inauguration.mp4
images/gallery/bbci_gallery/BBCI Inauguration.mp4
