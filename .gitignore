.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# --- Deployment Platform Caches & Build Outputs ---
.vercel
.wrangler/
.cloudflare/
.output/
dist/
build/

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example

# --- Dependencies & Package Managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python & Local Tooling Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
venv/
ENV/
env/
scratch/
.system_generated/
*.log
*.tmp

# --- Local Executables, Archives & Backups ---
*.exe
cloudflared.exe
*.zip
*.tar
*.gz
*.rar
*.7z
backup_receipts/
